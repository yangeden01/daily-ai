<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anniversary_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/item_card_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/anniversary_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#F3E8FF"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="今天"
        android:textColor="#7E22CE"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/anniversary_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Anniversary Title"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/anniversary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="第 1 週年"
        android:textColor="#9333EA"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
