<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/item_card_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/daily_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="09/14"
        android:textColor="#0284C7"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Daily Event Title"
        android:textColor="#0F172A"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/daily_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#F1F5F9"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="類別"
        android:textColor="#475569"
        android:textSize="10sp" />

</LinearLayout>
