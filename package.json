{
  "name": "mobile-notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "vite build && node -e \"import('node:fs').then(fs => fs.copyFileSync('dist/index.html', 'dist/404.html'))\"",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:build": "pnpm run build && cap sync android",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@vitejs/plugin-react": "latest",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "lunar-javascript": "^1.7.7",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "fake-indexeddb": "^6.2.5",
    "postcss": "latest",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.17",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
